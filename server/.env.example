# ============================================================
# Vutu 后端环境变量（宿主机 /opt/vutu-backend/.env，权限 600，不进仓库）
# ============================================================

NODE_ENV=production
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info

# ---------- 数据库 / 缓存 ----------
DATABASE_URL=postgresql://vutu:CHANGE_ME@postgres:5432/vutu?schema=public
REDIS_URL=redis://redis:6379

# ---------- 对象存储（同机 MinIO） ----------
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=vutuadmin
S3_SECRET_KEY=CHANGE_ME
S3_BUCKET=vutu
S3_FORCE_PATH_STYLE=true
# 上游/浏览器可达的公网基址（生成预签名 URL 用）；不填则用 S3_ENDPOINT
# S3_PUBLIC_ENDPOINT=http://<server-ip>:9000

# ---------- 认证 ----------
JWT_SECRET=CHANGE_ME_AT_LEAST_32_BYTES_LONG_RANDOM_STRING
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=2592000
BCRYPT_ROUNDS=12
ADMIN_TOKEN=CHANGE_ME_ADMIN_TOKEN

# ---------- 邮件发码（Resend） ----------
# 留空时：非生产环境验证码只写日志（联调用）；生产环境直接返回 503 EMAIL_NOT_CONFIGURED
RESEND_API_KEY=
# 发件人。未绑自有域名前只能用 Resend 测试域，且仅能投递给 Resend 账户主邮箱
MAIL_FROM=Vutu <noreply@ai.vutu.cc>

# ---------- Google 登录 ----------
# Google Cloud Console 的 OAuth 客户端 ID（Web 类型）。
# 只需要 Client ID；ID token 走 JWKS 验签，不需要 Client Secret。
# 留空时 /v1/auth/oauth-providers 返回空数组，前端自动隐藏 Google 按钮。
GOOGLE_CLIENT_ID=

# ---------- 上游渠道（首期：灵客 AI / LK888） ----------
LK_BASE_URL=https://api.lk888.ai/api
# JSON 数组或逗号分隔；顺序即优先级。⚠️ 上线前必须轮换新 Key
LK_API_KEYS=[]
LK_KEY_STRATEGY=price_first
LK_TIMEOUT_MS=30000
LK_RATE_LIMIT_RPM=120

# ---------- Mock Provider ----------
# true = 全部生成走本地 Mock，零上游费用（staging/CI/压测强制）
MOCK_PROVIDER=true
MOCK_LATENCY_MS=3000
MOCK_FAIL_INJECTION=true

# ---------- 定价三常数（改此即改全站价） ----------
USD_TO_CNY=6.9
MARKUP=1.3
CREDITS_PER_USD=100

# ---------- 业务常量 ----------
SIGNUP_GRANT_CREDITS=100
SIGNUP_GRANT_TTL_DAYS=7
CHECKIN_CREDITS=5
TASK_TIMEOUT_MIN=30
TASK_MAX_RETRY=3
POLL_INTERVAL_SEC=15
DELIVERY_URL_TTL_SEC=14400
VIEW_URL_TTL_SEC=900
UPLOAD_URL_TTL_SEC=900

# ---------- 内容审核 ----------
MODERATION_L1_ENABLED=true
MODERATION_L2_ENABLED=true
MODERATION_L2_TIMEOUT_MS=3000
MODERATION_CACHE_TTL_SEC=86400

# ---------- 产物保留期 ----------
RETENTION_FREE_DAYS=30
RETENTION_PRO_DAYS=90

# ---- xiaoye-adoption F1/F2/F4（docs/xiaoye-adoption-design.md §9；模块内解析，不入 core/config）----
# 优化/反推每次扣费（积分，决议 D1 走账本 service_deduct）
PROMPT_OPTIMIZE_CREDITS=1
PROMPT_REVERSE_CREDITS=2
# 每用户限频：分钟 / 日（单实例内存窗口，多副本需换 Redis —— 见 providers/chat.ts 注释）
PROMPT_OPTIMIZE_PER_MIN=10
PROMPT_OPTIMIZE_PER_DAY=100
PROMPT_REVERSE_PER_MIN=6
PROMPT_REVERSE_PER_DAY=60
# 广场发布是否自动通过（决议 D3 默认 true；false = 人工审核走 admin prompt-posts）
PROMPT_AUTO_APPROVE=true
# LK 对话模型（/v1/chat/completions，OpenAI 格式；真实模式必填，MOCK_PROVIDER=true 时不校验）
# 反推需要 vision → 用带 vision 的（可选名单见 docs/lk888-capabilities.md §Chat/LLM）；换模型只改这一行
LK_CHAT_MODEL=deepseek-v4-flash-vision-exp
